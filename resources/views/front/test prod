/* =========================================================
   RAINBOW COLORS
   CATEGORY PAGE — FEATURED PRODUCT
========================================================= */

.rainbow-featured-product {
    position: relative;
    padding: 60px 0 110px;
    background: #F7F5FB;
    overflow: hidden;
}

.featured-product__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 70px;
}

/* Visual */

.featured-product__visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
}

.featured-product__ring {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 440px;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 40px 90px rgba(41, 35, 69, .12);
}

.featured-product__ring::before {
    content: "";
    position: absolute;
    inset: -14px;
    border-radius: 50%;
    border: 1px dashed rgba(41, 35, 69, .15);
}

.featured-product__ring img {
    width: 55%;
    height: auto;
    filter: drop-shadow(0 25px 30px rgba(0, 0, 0, .18));
    transition: opacity .3s ease, transform .3s ease;
}

.featured-product__badge {
    position: absolute;
    bottom: 8%;
    right: 2%;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 12px 20px;
    background: #292345;
    border-radius: 50px;
    color: #FDD200;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .3px;
    box-shadow: 0 20px 40px rgba(41, 35, 69, .25);
}

/* Info */

.featured-product__info h2 {
    margin: 20px 0 0;
    color: #292345;
    font-size: clamp(30px, 3.5vw, 42px);
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: -.5px;
}

.featured-product__info > p {
    max-width: 480px;
    margin: 20px 0 0;
    color: #6F6A7D;
    font-size: 15px;
    line-height: 1.85;
}

.featured-product__label {
    display: block;
    margin-bottom: 12px;
    color: #8A8696;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
}

/* Sizes */

.featured-product__sizes {
    margin-top: 34px;
}

.size-chips {
    display: flex;
    gap: 10px;
}

.size-chip {
    padding: 10px 20px;
    border-radius: 30px;
    border: 1.5px solid rgba(41, 35, 69, .12);
    background: #fff;
    color: #6F6A7D;
    font-size: 13.5px;
    font-weight: 700;
    cursor: pointer;
    transition: all .25s ease;
}

.size-chip.active,
.size-chip:hover {
    background: #292345;
    border-color: #292345;
    color: #fff;
}

/* Colours */

.featured-product__colours {
    margin-top: 30px;
}

.colour-swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

.swatch {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 3px solid #fff;
    box-shadow: 0 0 0 1.5px rgba(41, 35, 69, .15);
    cursor: pointer;
    padding: 0;
    transition: all .25s ease;
}

.swatch--white {
    box-shadow: 0 0 0 1.5px rgba(41, 35, 69, .3);
}

.swatch:hover {
    transform: translateY(-3px);
}

.swatch.active {
    box-shadow: 0 0 0 2.5px #292345;
    transform: scale(1.12);
}

.selected-colour-name {
    display: inline-block;
    margin-top: 14px;
    color: #292345;
    font-size: 13.5px;
    font-weight: 700;
}

/* CTA button (reuses .rainbow-btn from About page) */

.featured-product__info .rainbow-btn {
    margin-top: 38px;
}

