========================================================= */

.rainbow-product-slider {
    position: relative;
    padding: 90px 0;
    background: #292345;
    overflow: hidden;
}

.rainbow-product-slider__header {
    margin-bottom: 55px;
    text-align: center;
}

.rainbow-product-slider__header .rainbow-section-label {
    justify-content: center;
}

.rainbow-product-slider__header h2 {
    margin: 16px 0 0;
    color: #fff;
    font-size: clamp(28px, 3.5vw, 38px);
    font-weight: 800;
    letter-spacing: -.5px;
}

.slider-track-wrapper {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
}

.slider-track {
    display: flex;
    gap: 26px;
    width: max-content;
    animation: sliderScroll 28s linear infinite;
}

.slider-track:hover {
    animation-play-state: paused;
}

@keyframes sliderScroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
}

.slider-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    width: 170px;
    padding: 26px 18px;
    background: rgba(255, 255, 255, .04);
    border: 1px solid rgba(255, 255, 255, .08);
    border-radius: 20px;
    flex-shrink: 0;
    transition: all .3s ease;
}

.slider-item:hover {
    background: rgba(255, 255, 255, .07);
    border-color: rgba(253, 210, 0, .3);
    transform: translateY(-4px);
}

.slider-item img {
    width: 90px;
    height: 90px;
    object-fit: contain;
    filter: drop-shadow(0 10px 15px rgba(0, 0, 0, .25));
}

.slider-item span {
    color: #C8C4D8;
    font-size: 12.5px;
    font-weight: 600;
}

